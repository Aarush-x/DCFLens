FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN groupadd --system --gid 10001 appgroup \
    && useradd --system --uid 10001 --gid appgroup --create-home appuser

COPY apps/api/requirements.txt apps/api/requirements-workflows.txt ./
RUN python -m pip install --no-cache-dir -r requirements-workflows.txt
COPY --chown=appuser:appgroup apps/api/app ./app

USER appuser
# Workflows register/execute tasks through the SDK, not an HTTP server.
CMD ["python", "-m", "app.workflow"]
