# Application mode: development or production.
APP_ENV=development

# Logging and process-local cache configuration.
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=128

# Server-only Gemini configuration. Never expose the key to apps/web.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Per-attempt I/O timeout (1..120 seconds); capped by the remaining budget.
GEMINI_TIMEOUT_SECONDS=45
# Shared scheduling budget across retries and models (1..120 seconds).
GEMINI_TOTAL_TIMEOUT_SECONDS=75
# Delayed transient retries per model (0..3); eight total requests maximum.
GEMINI_MAX_RETRIES=2
# Initial exponential backoff (0.1..10 seconds), plus up to 0.25s jitter.
GEMINI_BACKOFF_SECONDS=1

# SEC requests require an application name and monitored contact email.
SEC_IDENTITY=DCFLens your-email@example.com
SEC_TIMEOUT_SECONDS=15
SEC_MAX_RETRIES=2

# Market price provider. SETTING THIS KEY IS WHAT SELECTS ALPHA VANTAGE --
# Yahoo is the fallback if Alpha Vantage fails; blank means Yahoo only. Free key:
# https://www.alphavantage.co/support/#api-key  (their published "demo" key also
# works, for a handful of symbols, if you just want to see a price appear.)
# Server-only, like GOOGLE_API_KEY. Never expose it to the frontend.
ALPHAVANTAGE_API_KEY=

# Exact comma-separated browser origins. Wildcards are rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional narrowly scoped Vercel preview support. Set both slugs or neither.
CORS_VERCEL_PREVIEW_PROJECT=
CORS_VERCEL_PREVIEW_TEAM=

# Render injects PORT. The Docker image defaults to 8000 locally.
PORT=8000
