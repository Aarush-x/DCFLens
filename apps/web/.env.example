# Public browser configuration. This value is embedded into the browser bundle
# at build time. Never put Gemini, SEC, Render, or other credentials here.
# Local `next dev` defaults to http://localhost:8000 when this is empty.
# Vercel Production and Preview must set the deployed Render API origin, with
# no path suffix required. Trailing slashes are normalized by the API client.
# Example only: https://your-render-service.example
NEXT_PUBLIC_API_URL=
